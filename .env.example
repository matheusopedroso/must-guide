# Copie para .env.local (fora do git). Sem o prefixo VITE_ → as chaves NÃO vão para o navegador.
# Usado só no "npm run dev"; em produção as chaves ficam no Secret Manager.

# Firebase (login + guias no Firestore). Console → Configurações do projeto → Seus apps → app Web.
# Estes COM VITE_ vão para o navegador de propósito: são públicos, quem protege é o firestore.rules.
# Também precisam existir no build de produção (o .env.local já vale para o "npm run build").
# Sem eles, o app funciona só com o rascunho no navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: endereço do site publicado (padrão: https://must-guide-app.web.app)
# VITE_SITE_URL=https://must-guide-app.web.app

# RAWG (https://rawg.io/apidocs)
RAWG_API_KEY=

# IGDB (só se GAMES_PROVIDER=igdb em functions/.env)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# PSN (troféus). Logado em playstation.com, abra https://ca.account.sony.com/api/v1/ssocookie
# e copie o valor de "npsso" (64 caracteres). Vale ~2 meses.
PSN_NPSSO=
