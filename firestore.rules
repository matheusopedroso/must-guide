rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Por enquanto só o dono do projeto entra.
    // Quando abrir para outras pessoas, troque por um campo/claim de admin.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'bh.matheuspedroso@gmail.com';
    }

    // Catálogo de jogos (cache do IGDB) — compartilhado
    match /games/{gameId} {
      allow read, write: if isAdmin();
    }

    // Guias — compartilhados (no futuro: leitura para todos os logados)
    match /guides/{guideId} {
      allow read, write: if isAdmin();
    }

    // Dados pessoais: biblioteca e progresso dos checklists
    match /users/{uid}/{document=**} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }
  }
}
