rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin = Custom Claim `admin` no Firebase Authentication (gravada pelo script
    // functions/scripts/set-admin.js). Não fica em nenhum documento, então ninguém se promove pelo app.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // Guias: guides/{guideId} — jogo (rawg-3498) ou DLC (rawg-3498~001), formato de src/utils/guideDraft.js.
    //   Publicado (status == 'published') → qualquer pessoa lê. Rascunho → só o admin.
    //   Só o admin grava, e o id do documento tem que bater com o guideId de dentro (guias antigos: gameId).
    match /guides/{guideId} {
      allow read: if isAdmin() || resource.data.get('status', 'draft') == 'published';
      allow create, update: if isAdmin()
        && request.resource.data.get('guideId', request.resource.data.gameId) == guideId
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if isAdmin();
    }

    // Cópias das listas de troféus da PSN: trophyLists/{NPWR12345_00} = { v, list, savedAt }.
    //   Dados públicos da PSN → qualquer pessoa lê (a leitura do guia não depende da API rodando).
    //   Só o admin grava (o editor atualiza a cópia ao abrir a lista pela API).
    match /trophyLists/{npId} {
      allow read: if true;
      allow write: if isAdmin() && npId.matches('NPWR[0-9]{5}_[0-9]{2}');
    }

    // Progresso pessoal (coletáveis marcados): só a própria pessoa, logada, lê e grava o seu
    match /users/{uid}/progress/{gameId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Biblioteca pessoal (jogando, quero platinar, platinado): users/{uid}/data/library — só a própria pessoa
    match /users/{uid}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo o resto fechado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
